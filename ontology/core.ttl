@prefix n8: <https://notariat8.github.io/ontology/id/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://notariat8.github.io/ontology/id/> a owl:Ontology ;
  rdfs:label "Notariats-Ontologie für NaC"@de ;
  rdfs:comment "Fachvokabular für Typen notarieller Vorgänge; keine Akten- oder Laufzeitdaten."@de ;
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> .

n8:Vorgangsart a owl:Class ;
  rdfs:subClassOf skos:Concept ;
  rdfs:label "Vorgangsart"@de ;
  rdfs:comment "Kanonischer Typ eines notariellen Geschäftsvorfalls, nicht der konkrete Mandatsvorgang."@de .

n8:Fachbereich a owl:Class ;
  rdfs:subClassOf skos:Concept ;
  rdfs:label "Fachbereich"@de .

n8:Fallbaustein a owl:Class ;
  rdfs:label "fachlicher Fallbaustein"@de ;
  rdfs:comment "Abstrakter Typ aus einem NaC-Usecase-Graphen; keine konkrete Akte."@de .

n8:Angabenfrage a owl:Class ; rdfs:subClassOf n8:Fallbaustein ;
  rdfs:label "offene Angabenfrage"@de .
n8:Dokumenttyp a owl:Class ; rdfs:subClassOf n8:Fallbaustein ;
  rdfs:label "Dokumenttyp"@de .
n8:Entscheidungspunkt a owl:Class ; rdfs:subClassOf n8:Fallbaustein ;
  rdfs:label "Entscheidungspunkt"@de .
n8:Pruefgate a owl:Class ; rdfs:subClassOf n8:Fallbaustein ;
  rdfs:label "Prüfgate"@de .
n8:Nachweistyp a owl:Class ; rdfs:subClassOf n8:Fallbaustein ;
  rdfs:label "Nachweistyp"@de .

n8:hatBaustein a owl:ObjectProperty ;
  rdfs:domain n8:Vorgangsart ; rdfs:range n8:Fallbaustein ;
  rdfs:label "hat Fallbaustein"@de .
n8:nacNodeId a owl:DatatypeProperty ; rdfs:range xsd:string ;
  rdfs:label "NaC-Knoten-ID"@de .
n8:lokaleNodeId a owl:DatatypeProperty ; rdfs:range xsd:string ;
  rdfs:label "lokale Knoten-ID"@de ;
  rdfs:comment "Kennung eines hier ergänzten Entwurfsbausteins ohne NaC-Vorlagen-ID; beginnt mit local."@de .
n8:quellstatus a owl:DatatypeProperty ; rdfs:range xsd:string ;
  rdfs:label "Vorlagenstatus laut NaC-Graph"@de .
n8:pflegeStatus a owl:DatatypeProperty ; rdfs:range xsd:string ;
  rdfs:label "Pflegestatus eines lokalen Entwurfsbausteins"@de .
n8:offeneFrage a owl:DatatypeProperty ; rdfs:range xsd:string ;
  rdfs:label "offene Fachfrage"@de .
n8:verantwortlicheRolle a owl:DatatypeProperty ; rdfs:range xsd:string ;
  rdfs:label "Rolle laut NaC-Graph"@de .
n8:datenschutzklasse a owl:DatatypeProperty ; rdfs:range xsd:string ;
  rdfs:label "Datenschutzklasse laut NaC-Graph"@de .
n8:erforderlichFuer a owl:DatatypeProperty ; rdfs:range xsd:string ;
  rdfs:label "benannter Kontext laut NaC-Graph"@de .
n8:entscheidungsoption a owl:DatatypeProperty ; rdfs:range xsd:string ;
  rdfs:label "Entscheidungsoption laut NaC-Graph"@de .
n8:dokumentquelle a owl:DatatypeProperty ; rdfs:range xsd:string ;
  rdfs:label "Dokumentquelle laut NaC-Graph"@de .
n8:enthaeltPersonendaten a owl:DatatypeProperty ; rdfs:range xsd:boolean ;
  rdfs:label "enthält potenziell Personendaten"@de .

n8:erfordert a owl:ObjectProperty ; rdfs:label "erfordert laut NaC-Graph"@de .
n8:informiert a owl:ObjectProperty ; rdfs:label "informiert laut NaC-Graph"@de .
n8:blockiertBisVollstaendig a owl:ObjectProperty ; rdfs:label "blockiert bis vollständig"@de .
n8:blockiertBisGeprueft a owl:ObjectProperty ; rdfs:label "blockiert bis geprüft"@de .
n8:erfordertEntscheidung a owl:ObjectProperty ; rdfs:label "erfordert Entscheidung"@de .
n8:belegtDurch a owl:ObjectProperty ; rdfs:label "belegt durch"@de .
n8:fuellt a owl:ObjectProperty ; rdfs:label "füllt"@de .
n8:bestimmt a owl:ObjectProperty ; rdfs:label "bestimmt"@de .

n8:hatBusinessCaseTypeId a owl:DatatypeProperty ;
  rdfs:domain n8:Vorgangsart ;
  rdfs:range xsd:string ;
  rdfs:label "NaC BusinessCaseTypeId"@de .

n8:hatNaCUsecase a owl:ObjectProperty ;
  rdfs:domain n8:Vorgangsart ;
  rdfs:label "NaC-Usecase"@de .

n8:hatBpmnModell a owl:ObjectProperty ;
  rdfs:domain n8:Vorgangsart ;
  rdfs:label "BPMN-Modell"@de .

n8:hatFachbereich a owl:ObjectProperty ;
  rdfs:domain n8:Vorgangsart ;
  rdfs:range n8:Fachbereich ;
  rdfs:label "Fachbereich"@de .

n8:pruefstatus a owl:DatatypeProperty ;
  rdfs:domain n8:Vorgangsart ;
  rdfs:range xsd:string ;
  rdfs:label "fachlicher Prüfstatus"@de ;
  rdfs:comment "Katalogstatus; keine juristische Wirksamkeitsentscheidung."@de .
